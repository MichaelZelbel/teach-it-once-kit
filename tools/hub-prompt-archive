#!/usr/bin/env python3
"""hub-prompt-archive - put what you actually typed into your hub, so any AI can search it.

WHY THIS FILE EXISTS. You should be able to ask any of your assistants about a prompt you
wrote months ago, or a project you did with one. The raw material already exists and nothing
can reach it: every AI tool keeps its own conversation logs, on one machine, outside your
folder, in its own format, and deletes them when it feels like it. On the machine this was
first written for, Claude Code alone held 121 conversation files.

THE NUMBER THAT DECIDED THE DESIGN. Those 121 files are 398 MB, which sounds like something
that cannot live in a git repo. Measured properly, only 565 of the 25,488 "user" entries are
things a human typed; the other 24,590 are tool results the harness files under the same
label. The real text is 1.4 MB. So it goes in the repo, plainly, exactly as he said it
should, and every machine gets it through the sync that already exists. Harvest the human
turns, never the transcript.

WHAT IS REMOVED BEFORE ANYTHING IS WRITTEN. A session transcript is the one place secrets
show up by accident: a key pasted while debugging, an employer or client name that this hub
is not allowed to hold. So every line passes a scrubber first:

  - by shape, needing no configuration: API keys and tokens, Authorization headers,
    private-key blocks, long random-looking strings, email addresses;
  - by name, from a list you keep OUTSIDE your hub, because a list of the names you must
    never store is itself a file you must never store. Put one name per line in
    ~/.hub/redact.txt, or set HUB_REDACT_TERMS.

A line that still looks risky after scrubbing is dropped whole rather than half-cleaned.
Refusing to store a prompt costs one prompt; storing a key costs a key.

Usage:
  hub-prompt-archive                       harvest this machine, write into prompts/archive/
  hub-prompt-archive --dry-run             show what it would add, write nothing
  hub-prompt-archive search <term>...      search everything every machine has archived
  hub-prompt-archive stats                 what is in the archive, and which machine stopped sending
  hub-prompt-archive sources               every place on THIS machine he types, and whether the
                                           archive has it. Exit 1 if a source reaches none of it.
  hub-prompt-archive rescrub               re-run the scrubber over what is already stored,
                                           for the day a name is added to the list too late
Options:
  --hub DIR · --since YYYY-MM-DD · --limit N (search results, default 12)
"""

import glob
import hashlib
import io
import json
import os
import re
import socket
import sys
from datetime import datetime, timezone

try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass


def home_dir():
    """Where the AI tools keep their session logs.

    HUB_HOME wins, and it exists for two real reasons rather than for tidiness. On Windows,
    Python resolves "~" from USERPROFILE and ignores HOME, so a test that sets HOME silently
    harvests your real sessions instead of its fixture, and reports green. And on the
    server this runs from cron, where HOME is whatever systemd decided.
    """
    return os.environ.get("HUB_HOME") or os.path.expanduser("~")


# The sources this collector can read. The installer shows this same list to the
# person as checkboxes; a new reader here must also be added to the installer's
# roster (kit-bootstrap: kb_ai_tool_info / Get-KitAiToolInfo), or nobody can
# switch it off.
SUPPORTED_SOURCES = ("claude", "codex", "hermes")


def device_env_value(name):
    """One value from ~/.hub/device.env. Read here as well as by the launcher,
    because this program is also run directly (`hub prompts archive`), where
    nothing has loaded that file into the environment first."""
    p = os.path.join(home_dir(), ".hub", "device.env")
    if not os.path.isfile(p):
        return None
    try:
        for raw in io.open(p, encoding="utf-8", errors="replace"):
            line = re.sub(r"^\s*export\s+", "", raw)
            if line.lstrip().startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == name:
                return v.strip().strip('"').strip("'")
    except (IOError, OSError):
        pass
    return None


def enabled_sources():
    """Which AI tools this machine's owner said may be read.

    The installer records the choice as HUB_PROMPT_SOURCES in ~/.hub/device.env
    (the environment wins, so a test or a one-off run can override it). No line
    at all means every supported source, which is what every machine did before
    there was a choice. An EMPTY line means none: a person who unticked every
    box made a decision, not a mistake.
    """
    v = os.environ.get("HUB_PROMPT_SOURCES")
    if v is None:
        v = device_env_value("HUB_PROMPT_SOURCES")
    if v is None:
        return set(SUPPORTED_SOURCES)
    if v.strip() == "-":
        # "-" is NONE spelled so it survives a Windows environment variable,
        # which cannot hold an empty string.
        return set()
    return {s.strip().lower() for s in v.split(",") if s.strip()}


def hub_root(argv_hub=None):
    if argv_hub:
        return os.path.abspath(argv_hub)
    env = os.environ.get("HUB_DIR")
    if env:
        return os.path.abspath(env)
    here = os.path.dirname(os.path.abspath(__file__))
    cand = os.path.abspath(os.path.join(here, "..", ".."))
    if os.path.isdir(os.path.join(cand, "memory")):
        return cand
    for c in ("/root/hub", os.path.expanduser("~/hub"), "C:\\hub"):
        if os.path.isdir(os.path.join(c, "memory")):
            return c
    return cand


# --------------------------------------------------------------- the scrubber

SECRET_PATTERNS = [
    (re.compile(r"\b(sk|pk|rk)-[A-Za-z0-9_\-]{16,}", re.I),        "[key removed]"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{16,}"),                   "[key removed]"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}"),                "[key removed]"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"),                           "[key removed]"),
    (re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}"),                      "[key removed]"),
    (re.compile(r"\bey[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"), "[token removed]"),
    # To END OF LINE, not to the next space. \S+ ate only the word "Bearer" and left the
    # token sitting there in plain sight, which the test caught on the first run. A header
    # value has spaces in it, so a pattern that stops at one is a pattern that leaks.
    (re.compile(r"(?i)\bauthorization\s*:.*"),                       "authorization: [removed]"),
    (re.compile(r"(?i)\b(bearer)\s+\S{8,}"),                         r"\1 [removed]"),
    (re.compile(r"(?i)\b(api[_-]?key|secret|token|password|passwd|pwd)\s*[:=]\s*\S+"),
     r"\1=[removed]"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S),
     "[private key removed]"),
    (re.compile(r"\bage1[a-z0-9]{40,}"),                            "[key removed]"),
    (re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b"), "[email removed]"),
]

# Something that still looks like a credential after the passes above. Anything matching
# this is not cleaned, it is dropped: a half-scrubbed secret is a stored secret.
STILL_RISKY = re.compile(r"[A-Za-z0-9+/_\-]{40,}={0,2}")


def redact_terms():
    out = []
    env = os.environ.get("HUB_REDACT_TERMS", "")
    out += [t.strip() for t in env.split(",") if t.strip()]
    p = os.path.join(home_dir(), ".hub", "redact.txt")
    if os.path.isfile(p):
        for line in io.open(p, encoding="utf-8", errors="replace"):
            line = line.split("#", 1)[0].strip()
            if line:
                out.append(line)
    return [t for t in out if len(t) >= 3]


def scrub(text, terms):
    """Returns (clean_text, dropped_reason_or_None)."""
    t = text
    for rx, rep in SECRET_PATTERNS:
        t = rx.sub(rep, t)
    for term in terms:
        t = re.sub(re.escape(term), "[name removed]", t, flags=re.I)
    for m in STILL_RISKY.finditer(t):
        chunk = m.group(0)
        # A long run of mixed case and digits is a credential; a long path or a long word
        # is not. Requiring all three classes is what stops it eating ordinary prose.
        if (any(c.isdigit() for c in chunk) and any(c.islower() for c in chunk)
                and any(c.isupper() for c in chunk)):
            return None, "contains something that still looks like a credential"
    return t, None


# ------------------------------------------------------------------ harvesting

def human_turns_claude(paths):
    for f in paths:
        proj = os.path.basename(os.path.dirname(f))
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                if '"type":"user"' not in line and '"type": "user"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                c = d.get("message", {}).get("content")
                if isinstance(c, str):
                    txt = c
                elif isinstance(c, list):
                    # A tool result is filed as a "user" entry too. That is the 24,590.
                    if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
                        continue
                    txt = " ".join(b.get("text", "") for b in c
                                   if isinstance(b, dict) and b.get("type") == "text")
                else:
                    continue
                txt = (txt or "").strip()
                if not txt or txt.startswith("<") or txt.startswith("[Request interrupted"):
                    continue
                yield {"tool": "claude-code", "project": proj,
                       "at": d.get("timestamp", ""), "text": txt}
        except (IOError, OSError):
            continue


def human_turns_codex(paths):
    for f in paths:
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                if '"user"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                pay = d.get("payload", d)
                if pay.get("role") != "user" and pay.get("type") not in ("user_message",):
                    continue
                c = pay.get("content", pay.get("message", ""))
                if isinstance(c, list):
                    c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
                c = (c or "").strip() if isinstance(c, str) else ""
                if not c or c.startswith("<"):
                    continue
                yield {"tool": "codex", "project": "", "at": d.get("timestamp", ""), "text": c}
        except (IOError, OSError):
            continue


def human_turns_hermes(path):
    """Your side of a chat log written as one line per message.

    TWO SHAPES, AND THE SECOND ONE IS THE REAL FILE. This started out reading a "role" or
    "from" field, which is what a chat log usually has. A real one turned out to have
    neither: every line was {"ts": ..., "dir": "in"|"out", "text": ...}, where "in" means the
    person typed it and "out" means the bot said it. So the filter matched nothing at all, on
    every line, for as long as it existed. Nothing failed and nothing was logged; the drawer
    was simply empty of everything typed from a phone. Both shapes are read now, and the test
    suite holds the "dir" one shut.
    """
    if not os.path.isfile(path):
        return
    try:
        for line in io.open(path, encoding="utf-8", errors="replace"):
            try:
                d = json.loads(line)
            except Exception:
                continue
            who = (d.get("role") or d.get("from") or "").lower()
            direction = (d.get("dir") or d.get("direction") or "").lower()
            if direction:
                # "out" is the bot talking. Archiving it would fill the drawer with our own
                # words and make every search return the answer instead of the question.
                if direction not in ("in", "inbound"):
                    continue
            elif who not in ("user", "michael", "human"):
                continue
            txt = (d.get("text") or d.get("content") or "").strip()
            if txt:
                yield {"tool": "telegram", "project": "", "at": d.get("ts", d.get("at", "")), "text": txt}
    except (IOError, OSError):
        return


TELEGRAM_TRANSCRIPT = "/var/lib/hub-telegram/transcript.jsonl"


# A message our own machinery put into a chat wearing the human's role. The courier hands a
# desk a "[WORK ORDER from the company ...]", the compressor injects "[CONTEXT COMPACTION -
# REFERENCE ONLY]", a scheduled run opens with "[IMPORTANT: You are running as ...]". None of
# those is a thing you typed, and archiving them would fill the drawer with a program's words.
# The tell is the shouted opening tag: our machinery announces itself in capitals inside
# square brackets, and a human does not. So a name label like "[Sam] ..." survives, and so does
# a quote wrapper like '[Replying to: "x"]', because those are your own words with a label
# glued on the front. The label comes off below, so a search for the first word you typed finds it.
MACHINE_BANNER = re.compile(r"^\[[A-Z][A-Z0-9 ]{2,}")

# Some chat bridges glue the speaker's name in front of every message. It is not part of the
# prompt, so it comes off. The machine-banner test above has already run, so a shouted tag is
# gone by now and this can only ever strip an ordinary name.
SPEAKER_LABEL = re.compile(r"^\[[A-Z][A-Za-z ]{0,20}\]\s*")


def hermes_home():
    """Where the Hermes bots keep their own store.

    Hermes is a chat-bot runner: if you have one, each bot keeps its own small database of
    the conversations it has had, and what you typed to it lives nowhere else.

    HUB_HERMES_HOME wins so a test can point at a fixture. Otherwise a server-wide install,
    then this user's own, then nothing at all, which is the normal and correct answer on a
    computer that runs no bots.
    """
    env = os.environ.get("HUB_HERMES_HOME")
    if env:
        return env
    for c in ("/home/hermes/.hermes", os.path.join(home_dir(), ".hermes")):
        if os.path.isdir(os.path.join(c, "profiles")):
            return c
    return None


def human_turns_hermes_store(hermes):
    """Everything you typed to EVERY chat bot on this machine, from the bots' own store.

    WHY THIS EXISTS. This used to harvest exactly one bot, and only because a separate
    nightly job exported that one bot's conversations into a single file whose path was
    written into the code above. Every other bot on the same machine had no such job and no
    such file, so every word typed to any of them was kept nowhere: on the machine where this
    was found, eight bots and 281 prompts, with nothing anywhere saying so.

    The shape of that bug is the point. A source you reach through a per-bot file is a source
    somebody has to remember to plumb, once per bot, for ever, and the day a new bot appears
    it starts losing your words in silence. So this does not read a file that another job
    writes. It reads the place the bots themselves write: profiles/<name>/state.db, one small
    sqlite database per bot, holding its conversations and their messages. A bot made
    tomorrow is covered tomorrow, with nothing to install and nothing to remember.

    Only conversations whose source is 'telegram' are read, because those are the ones a
    person had. The other sources in that same database (api_server, cron, cli, webhook) are
    programs giving the bot work, and their "user" turns are prompts a program wrote.
    """
    import sqlite3  # only needed here, and only on a machine that runs bots
    if not hermes:
        return
    for db in sorted(glob.glob(os.path.join(hermes, "profiles", "*", "state.db"))):
        bot = os.path.basename(os.path.dirname(db))
        try:
            # Read-only, so a live bot writing to the same database is never disturbed.
            con = sqlite3.connect("file:" + db.replace("?", "%3f") + "?mode=ro", uri=True)
            rows = con.execute(
                "SELECT m.timestamp, m.content FROM messages m "
                "JOIN sessions s ON s.id = m.session_id "
                "WHERE s.source = 'telegram' AND m.role = 'user' "
                "ORDER BY m.timestamp").fetchall()
            con.close()
        except Exception as e:
            # Loud on purpose. A bot we cannot read is a bot whose prompts are being lost,
            # and the whole lesson of this file is that such a loss must never be silent.
            print("  NOTE: could not read the store of the '%s' bot (%s), so what you typed "
                  "to it is NOT being archived." % (bot, e))
            continue
        for ts, txt in rows:
            txt = (txt or "").strip()
            if not txt or MACHINE_BANNER.match(txt):
                continue
            txt = SPEAKER_LABEL.sub("", txt).strip()
            if not txt:
                continue
            try:
                at = datetime.fromtimestamp(float(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
            except Exception:
                at = ""
            yield {"tool": "telegram", "project": bot, "at": at, "text": txt}


def harvest(hub):
    """Every source the person has switched ON. A source that is off is not read at
    all, rather than read-and-discarded: the promise to the person is that this
    program does not open that tool's files, not that it forgets what it saw."""
    home = home_dir()
    on = enabled_sources()
    if "claude" in on:
        yield from human_turns_claude(glob.glob(os.path.join(home, ".claude", "projects", "*", "*.jsonl")))
    if "codex" in on:
        codex = os.path.join(home, ".codex", "sessions")
        yield from human_turns_codex([os.path.join(r, f) for r, _d, fs in os.walk(codex)
                                      for f in fs if f.endswith(".jsonl")])
    if "hermes" in on:
        # Overridable so a test can point it at a fixture. A path compiled into the code is a
        # path no test can reach, which is exactly how the "dir" bug above survived.
        yield from human_turns_hermes(os.environ.get("HUB_TELEGRAM_TRANSCRIPT") or TELEGRAM_TRANSCRIPT)
        # Kept alongside the line above rather than replacing it: that file carries chat from
        # before the current store existed, and the two overlap harmlessly because a prompt is
        # recognised by its text, so whichever reader reaches it first is the only one that counts.
        yield from human_turns_hermes_store(hermes_home())


# --------------------------------------------------------------------- storage

def archive_dir(hub):
    return os.path.join(hub, "prompts", "archive")


def library_files(hub):
    """The saved prompts, which is every .md in the shelf EXCEPT its own front door.

    prompts/README.md and prompts/library/README.md explain the drawers to a human. They are
    not prompts, and counting them as prompts would put the explanation itself in every
    search result and inflate `stats` by two.
    """
    out = []
    for f in sorted(glob.glob(os.path.join(hub, "prompts", "library", "*.md"))):
        if os.path.basename(f).lower() in ("readme.md", "index.md"):
            continue
        out.append(f)
    return out


def lock_or_exit(hub):
    """One harvest at a time on one machine.

    Three things now start a harvest (a session ending, the daily task, a human proving it
    works), so two can overlap. Both would read the same seen-set, find the same new prompts
    and append them twice, because the file is opened in append mode. An exclusive lock file
    is the cheapest fix that works on Windows and Linux alike. A stale lock older than an
    hour is ignored: a crashed run must not switch the harvest off for ever.
    """
    os.makedirs(archive_dir(hub), exist_ok=True)
    p = os.path.join(archive_dir(hub), ".harvest.lock")
    try:
        if os.path.isfile(p) and (datetime.now(timezone.utc).timestamp() - os.path.getmtime(p)) > 3600:
            os.remove(p)
    except OSError:
        pass
    try:
        fd = os.open(p, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except OSError:
        return None
    return p


def load_seen(hub):
    seen = set()
    for f in sorted(glob.glob(os.path.join(archive_dir(hub), "*.jsonl"))):
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                try:
                    seen.add(json.loads(line)["id"])
                except Exception:
                    continue
        except (IOError, OSError):
            continue
    return seen


def month_of(at):
    if at and len(at) >= 7 and at[4] == "-":
        return at[:7]
    return datetime.now(timezone.utc).strftime("%Y-%m")


def cmd_harvest(hub, dry, since, machine):
    lock = None
    if not dry:
        lock = lock_or_exit(hub)
        if lock is None:
            print("another harvest is already running on this machine, so this one did nothing")
            return 0
    try:
        return _harvest_locked(hub, dry, since, machine)
    finally:
        if lock:
            try:
                os.remove(lock)
            except OSError:
                pass


def _harvest_locked(hub, dry, since, machine):
    terms = redact_terms()
    seen = load_seen(hub)
    buckets, added, dropped, dupes = {}, 0, 0, 0
    for rec in harvest(hub):
        if since and (rec["at"] or "")[:10] < since:
            continue
        rid = hashlib.sha256(("%s|%s" % (rec["tool"], rec["text"])).encode("utf-8")).hexdigest()[:16]
        if rid in seen:
            dupes += 1
            continue
        clean, why = scrub(rec["text"], terms)
        if clean is None:
            dropped += 1
            continue
        seen.add(rid)
        row = {"id": rid, "at": rec["at"][:19], "machine": machine, "tool": rec["tool"],
               "project": rec["project"], "text": clean}
        buckets.setdefault(month_of(rec["at"]), []).append(row)
        added += 1

    if not dry:
        os.makedirs(archive_dir(hub), exist_ok=True)
        for month, rows in sorted(buckets.items()):
            p = os.path.join(archive_dir(hub), "%s-%s.jsonl" % (machine, month))
            with io.open(p, "a", encoding="utf-8", newline="\n") as fh:
                for r in sorted(rows, key=lambda r: r["at"]):
                    fh.write(json.dumps(r, ensure_ascii=False) + "\n")

    print("%s %d prompt%s from this machine (%s)"
          % ("would archive" if dry else "archived", added, "" if added == 1 else "s", machine))
    for month, rows in sorted(buckets.items()):
        print("  %s-%s.jsonl  +%d" % (machine, month, len(rows)))
    print("  %d skipped: already archived, or the same thing typed twice" % dupes)
    off = sorted(set(SUPPORTED_SOURCES) - enabled_sources())
    if off:
        print("  not read, by your choice: %s" % ", ".join(off))
    if dropped:
        print("  %d dropped: still looked like a credential after scrubbing" % dropped)
    if not terms:
        print("\n  NOTE: no name list configured, so only key-shaped text was removed.")
        print("  To also strip employer or client names: put one per line in ~/.hub/redact.txt")
        print("  (that file is never committed), or set HUB_REDACT_TERMS in the secrets store.")
    return 0


def cmd_rescrub(hub, dry):
    """Run today's scrubber over what is ALREADY in the archive.

    WHY THIS EXISTS. The scrubber only ever ran at the moment a prompt was written, so the
    name list protected the future and nothing else. The day you add your employer to
    ~/.hub/redact.txt, every prompt already in the repository still carries it. That is the
    wrong way round: the list is exactly the thing you discover you needed AFTER the fact.

    A row that is now clean is rewritten. A row that now looks like a credential is dropped
    whole, same rule as the harvest: losing one prompt costs one prompt.
    """
    terms = redact_terms()
    if not terms:
        print("no name list found, so a rescrub would only redo the key-shaped patterns.")
        print("Put one name per line in %s (never committed), or set HUB_REDACT_TERMS."
              % os.path.join(home_dir(), ".hub", "redact.txt"))
    changed = dropped = total = 0
    for f in sorted(glob.glob(os.path.join(archive_dir(hub), "*.jsonl"))):
        out, file_changed = [], False
        for line in io.open(f, encoding="utf-8", errors="replace"):
            line = line.rstrip("\n")
            if not line.strip():
                continue
            try:
                r = json.loads(line)
            except Exception:
                out.append(line)
                continue
            total += 1
            clean, why = scrub(r.get("text", ""), terms)
            if clean is None:
                dropped += 1
                file_changed = True
                continue
            if clean != r.get("text"):
                r["text"] = clean
                changed += 1
                file_changed = True
            out.append(json.dumps(r, ensure_ascii=False))
        if file_changed and not dry:
            with io.open(f, "w", encoding="utf-8", newline="\n") as fh:
                fh.write("\n".join(out) + "\n")
    print("%s %d of %d archived prompts: %d cleaned, %d dropped whole"
          % ("would change" if dry else "changed", changed + dropped, total, changed, dropped))
    if not dry and (changed or dropped):
        print("Commit prompts/archive/ so every machine gets the cleaned copy.")
    return 0


def cmd_sources(hub, machine):
    """Every place on THIS machine that you type to an AI, and whether it reaches the drawer.

    WHY THIS COMMAND EXISTS. The guard we already had counts prompts per MACHINE, and it was
    green throughout the failure it was written to catch a milder version of. The server was
    archiving every day, from its Claude sessions and one bot, so 'the server is contributing'
    was true while eight other bots on that same machine were losing every word typed
    to them. Counting machines cannot see a missing SOURCE, because a machine with one working
    source looks exactly like a machine with all of them.

    So this measures the property directly: read what this machine can see, one source at a
    time, and ask of each one whether the archive already holds it. A source with prompts in
    it and none of them archived is a leak, and there is no innocent reading of that.

    Exit 0 = every source this machine has is represented, 1 = at least one is not.
    """
    seen = load_seen(hub)
    have, total, newest = {}, {}, {}
    for rec in harvest(hub):
        key = (rec["tool"], rec["project"] if rec["tool"] == "telegram" else "")
        rid = hashlib.sha256(("%s|%s" % (rec["tool"], rec["text"])).encode("utf-8")).hexdigest()[:16]
        total[key] = total.get(key, 0) + 1
        if rid in seen:
            have[key] = have.get(key, 0) + 1
        at = (rec["at"] or "")[:10]
        if at > newest.get(key, ""):
            newest[key] = at

    # A source switched off is silent in the numbers above because it was never read.
    # Said out loud here so its silence reads as the person's choice, not as a leak:
    # the selftest that runs this command must not alarm on a decision.
    off = sorted(set(SUPPORTED_SOURCES) - enabled_sources())

    if not total:
        if off:
            print("switched off by your choice, so not read at all: %s" % ", ".join(off))
        print("this machine has no readable AI session logs, so there is nothing here to archive.")
        return 0

    print("what this machine (%s) can see, and whether the archive has it:" % machine)
    if off:
        print("  (switched off by your choice, so not read at all: %s)" % ", ".join(off))
    leaks = []
    for key in sorted(total, key=lambda k: -total[k]):
        name = key[0] + ("/" + key[1] if key[1] else "")
        n, h = total[key], have.get(key, 0)
        print("  %-28s %6d typed   %6d archived   newest %s"
              % (name, n, h, newest.get(key) or "undated"))
        if h == 0:
            leaks.append((name, n))

    for name, n in leaks:
        print("PROMPT SOURCE LOST: %d prompt%s typed into '%s' on this machine, and not one of "
              "them is in the archive. Everything you say there is being thrown away. Run "
              "`hub prompts archive` here and read what it says."
              % (n, "" if n == 1 else "s", name))
    return 1 if leaks else 0


def all_rows(hub):
    for f in sorted(glob.glob(os.path.join(archive_dir(hub), "*.jsonl"))):
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                try:
                    yield json.loads(line)
                except Exception:
                    continue
        except (IOError, OSError):
            continue


def cmd_search(hub, terms, limit):
    if not terms:
        sys.stderr.write("usage: hub prompts search <term> [<term>...]\n"); return 1
    low = [t.lower() for t in terms]
    hits = []
    for r in all_rows(hub):
        t = r.get("text", "").lower()
        n = sum(1 for x in low if x in t)
        if n:
            hits.append((n, t.count(low[0]), r))

    lib = []
    for f in library_files(hub):
        body = io.open(f, encoding="utf-8", errors="replace").read()
        if all(x in body.lower() for x in low):
            lib.append((os.path.basename(f)[:-3], body))

    if not hits and not lib:
        print("nothing you have typed to any AI matches %s." % " + ".join(terms))
        print("That is a checked absence, not an error. The archive covers what has been")
        print("harvested so far: run `hub prompts archive` on a machine to add its history.")
        return 0

    if lib:
        print("SAVED PROMPTS (%d):" % len(lib))
        for name, body in lib[:limit]:
            purpose = re.search(r"^purpose:\s*\"?(.+?)\"?$", body, re.M)
            print("  %s%s" % (name, " - " + purpose.group(1) if purpose else ""))
            print("     read it: hub prompts get %s" % name)
        print("")

    hits.sort(key=lambda h: (-h[0], -h[1], h[2].get("at", "")))
    print("THINGS YOU TYPED (%d of %d match, showing %d):"
          % (len(hits), sum(1 for _ in all_rows(hub)), min(limit, len(hits))))
    for _n, _c, r in hits[:limit]:
        when = (r.get("at") or "")[:10] or "undated"
        where = "%s/%s" % (r.get("machine", "?"), r.get("tool", "?"))
        txt = " ".join(r.get("text", "").split())
        if len(txt) > 240:
            txt = txt[:237] + "..."
        print("\n  %s  %s%s" % (when, where, "  [%s]" % r["project"] if r.get("project") else ""))
        print("  %s" % txt)
    if len(hits) > limit:
        print("\n(%d more; add --limit N)" % (len(hits) - limit))
    return 0


def cmd_get(hub, args):
    if not args:
        sys.stderr.write("usage: hub prompts get <name>\n"); return 1
    want = args[0].lower().removesuffix(".md")
    for f in library_files(hub):
        if os.path.basename(f)[:-3].lower() == want:
            sys.stdout.write(io.open(f, encoding="utf-8").read()); return 0
    part = [f for f in library_files(hub) if want in os.path.basename(f).lower()]
    if len(part) == 1:
        sys.stdout.write(io.open(part[0], encoding="utf-8").read()); return 0
    if part:
        print("'%s' matches %d saved prompts. Name one:" % (args[0], len(part)))
        for f in part:
            print("  %s" % os.path.basename(f)[:-3])
        return 1
    print("no saved prompt called '%s'. Try: hub prompts search %s" % (args[0], args[0]))
    return 1


def cmd_stats(hub):
    """What is in the archive, and WHICH MACHINE STOPPED SENDING.

    The count alone is what let this run for a month with only the work PC in it: 1,122
    prompts looks healthy until you notice every one is from the same computer. So the
    newest prompt per source is printed beside the count. A source whose newest prompt is
    weeks old is a harvest that has quietly stopped, and hub-selftest reads exactly this.
    """
    rows = list(all_rows(hub))
    by, last = {}, {}
    for r in rows:
        k = (r.get("machine", "?"), r.get("tool", "?"))
        by[k] = by.get(k, 0) + 1
        at = (r.get("at") or "")[:10]
        if at > last.get(k, ""):
            last[k] = at
    chars = sum(len(r.get("text", "")) for r in rows)
    print("archived prompts   %d  (%.1f MB of text)" % (len(rows), chars / 1e6))
    print("  %-14s %-12s %8s  %s" % ("machine", "tool", "prompts", "newest"))
    for k, n in sorted(by.items(), key=lambda kv: -kv[1]):
        print("  %-14s %-12s %8d  %s" % (k[0], k[1], n, last.get(k) or "undated"))
    print("machines           %d" % len(set(m for m, _t in by)))
    print("saved prompts      %d  (prompts/library/)" % len(library_files(hub)))
    dates = sorted(r.get("at", "")[:10] for r in rows if r.get("at"))
    if dates:
        print("covers             %s to %s" % (dates[0], dates[-1]))
    return 0


def main(argv):
    args, hub_arg, dry, since, limit = [], None, False, None, 12
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--hub" and i + 1 < len(argv):
            hub_arg = argv[i + 1]; i += 2; continue
        if a == "--since" and i + 1 < len(argv):
            since = argv[i + 1]; i += 2; continue
        if a == "--limit" and i + 1 < len(argv):
            try:
                limit = max(1, int(argv[i + 1]))
            except ValueError:
                pass
            i += 2; continue
        if a in ("--dry-run", "-n"):
            dry = True; i += 1; continue
        args.append(a); i += 1

    hub = hub_root(hub_arg)
    machine = re.sub(r"[^a-z0-9]+", "-", (os.environ.get("HUB_MACHINE") or socket.gethostname()).lower()).strip("-")
    cmd = args[0] if args else "archive"
    rest = args[1:]
    if cmd in ("archive", "harvest"):
        return cmd_harvest(hub, dry, since, machine)
    if cmd == "search":
        return cmd_search(hub, rest, limit)
    if cmd == "get":
        return cmd_get(hub, rest)
    if cmd == "stats":
        return cmd_stats(hub)
    if cmd == "sources":
        return cmd_sources(hub, machine)
    if cmd == "rescrub":
        return cmd_rescrub(hub, dry)
    sys.stderr.write("usage: hub prompts archive | search <term> | get <name> | stats | sources | rescrub\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
